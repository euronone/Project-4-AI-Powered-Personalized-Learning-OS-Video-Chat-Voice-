# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_DB_URL=sqlite+aiosqlite:///./test.db
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379

# AI
ANTHROPIC_API_KEY=<claude-api-key>
OPENAI_API_KEY=<openai-api-key>
EURON_API_KEY=your_euron_api_key_here
LLM_PROVIDER=euron
LLM_MODE=real
EURON_BASE_URL=https://api.euron.one/api/v1/euri


# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Sentiment
SENTIMENT_FRAME_INTERVAL_MS=5000
SENTIMENT_CONFIDENCE_THRESHOLD=0.6
